   ]
  },
  {
   "cell_type": "markdown",
   "id": "b69e9f05",
   "metadata": {},
   "source": [
    "*Two variables, 'Gender' and 'Smoking history' to be encoded*"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a495ad57",
   "metadata": {},
   "source": [
    "* Split data into train and test"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7087df9a",
   "metadata": {},
   "outputs": [],
   "source": [
    "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42, stratify=y)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "502b31bc",
   "metadata": {},
   "outputs": [],
   "source": [
    "# check on split data\n",
