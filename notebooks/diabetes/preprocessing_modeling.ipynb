      "source": [
        "random_forest_smote = Pipeline([\n",
        "    (\"preprocessor\", rf_preprocessor),\n",
        "    (\"model\", RandomForestClassifier(\n",
        "        n_estimators=100,\n",
        "        random_state=42\n",
        "    ))\n",
