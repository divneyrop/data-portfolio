  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3534a868",
   "metadata": {},
   "outputs": [],
   "source": [
    "log_reg_balanced.fit(X_train, y_train)\n",
    "\n",
    "y_pred = log_reg_balanced.predict(X_test)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e31aed2a",
   "metadata": {},
   "outputs": [],
   "source": [
    "def report (y_test, y_pred):\n",
    "    accuracy = accuracy_score(y_test, y_pred)\n",
    "    cm = confusion_matrix(y_test, y_pred)\n",
    "    class_report = classification_report(y_test, y_pred)\n",
    "    print(f\" Accuracy: {accuracy}\\n Confusion matrix: \\n{cm}\\n Classification report: \\n{class_report}\")\n",
    "\n",
    "report(y_test, y_pred)\n"
   ]
  },
  {
   "cell_type": "markdown",
